APP_NAME=Barlas AI Agent
BARLAS_DOMAIN=agent.example.com
BARLAS_HTTP_PORT=18080
BARLAS_HTTPS_PORT=18443
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
BARLAS_API_TOKEN=replace-with-at-least-32-random-characters
MODEL_PROVIDER=openai
MODEL_NAME=replace-with-fast-model-name
MODEL_API_KEY=replace-with-dedicated-model-key
VISION_MODEL=replace-with-vision-model-name
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SPEECH_MODEL=gpt-4o-mini-tts
EMBEDDING_MODEL=
DEEP_MODEL_NAME=replace-with-deep-model-name
CONNECTOR_VAULT_KEY=replace-with-output-of-openssl-rand-base64-32
CONNECTOR_VAULT_KEY_VERSION=1
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-unique-owner-password
OWNER_DISPLAY_NAME=Barlas Owner
OWNER_LANGUAGE=
BROWSER_WS_ENDPOINT=ws://browser:3000/
SANDBOX_SOCKET_PATH=/run/barlas-sandbox/sandbox.sock
SANDBOX_SHARED_TOKEN=replace-with-at-least-32-random-characters
# TELEGRAM_BOT_TOKEN=replace-with-dedicated-bot-token
# TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# SEARXNG_BASE_URL=https://search.example.com
AGENT_RUN_WORKER_ENABLED=true
AGENT_RUN_WORKER_POLL_MS=1000
AGENT_RUN_WORKER_BATCH_SIZE=2
AGENT_RUN_LEASE_SECONDS=300
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
