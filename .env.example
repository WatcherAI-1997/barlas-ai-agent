# Barlas AI Agent — non-secret configuration template
APP_ENV=development
APP_NAME=Barlas AI Agent
HOST=127.0.0.1
PORT=17840
LOG_LEVEL=info

# Set real values only in a local .env or secret manager.
DATABASE_URL=postgresql://barlas_agent:change-me@127.0.0.1:5432/barlas_agent
POSTGRES_PASSWORD=change-me
BARLAS_API_TOKEN=replace-with-at-least-32-random-characters
BARLAS_GATEWAY_TOKEN=replace-with-a-different-32-character-random-token
MODEL_PROVIDER=openai
MODEL_NAME=
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_COMMAND=claude
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
DEEP_MODEL_NAME=
DEEP_MODEL_INPUT_USD_PER_MILLION=
DEEP_MODEL_OUTPUT_USD_PER_MILLION=
MODEL_API_KEY=
# Required only for MODEL_PROVIDER=openai_compatible; include the API version root.
MODEL_BASE_URL=
VISION_MODEL=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SPEECH_MODEL=gpt-4o-mini-tts
EMBEDDING_MODEL=
PRIVATE_MODEL_BASE_URL=
PRIVATE_MODEL_NAME=
PRIVATE_MODEL_API_KEY=
PRIVATE_MODEL_INPUT_USD_PER_MILLION=0
PRIVATE_MODEL_OUTPUT_USD_PER_MILLION=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING_ENABLED=false
# Official Bot API accepts uploads up to 50 MB. A self-hosted local Bot API
# server can raise this to 2,000 MB; keep the byte limit aligned with it.
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
TELEGRAM_MAX_UPLOAD_BYTES=50000000
DISCORD_BOT_TOKEN=
DISCORD_GATEWAY_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SOCKET_MODE_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v23.0

# Optional encrypted per-user connector vault. Generate with: openssl rand -base64 32
# Required in production, even before the first connector is added.
CONNECTOR_VAULT_KEY=
CONNECTOR_VAULT_KEY_VERSION=1

# Durable background worker (runs inside the isolated Barlas service).
JOB_WORKER_ENABLED=true
JOB_WORKER_POLL_MS=1000
JOB_WORKER_BATCH_SIZE=4
JOB_LEASE_SECONDS=300

# Dedicated storage used only by Barlas AI Agent. Each user gets a hashed subdirectory.
WORKSPACE_ROOT=/var/lib/barlas/workspaces
BARLAS_STATE_DIR=/var/lib/barlas/workspaces
# Ordinary files are streamed and do not occupy application RAM. This is a
# per-file disk safety boundary, not a buffering boundary.
MAX_WORKSPACE_FILE_BYTES=2000000000

# Optional self-hosted SearXNG endpoint. web.search is disabled when omitted.
SEARXNG_BASE_URL=
BROWSER_WS_ENDPOINT=

# Optional isolated code runner over a private Unix socket. Generate the token
# with: openssl rand -hex 32
SANDBOX_SOCKET_PATH=
SANDBOX_SHARED_TOKEN=

# Per-user UTC-day limits.
DAILY_CHAT_QUOTA=500
DAILY_TOOL_QUOTA=1000
DAILY_JOB_QUOTA=100

# First owner for the Barlas gateway token.
OWNER_EMAIL=
OWNER_DISPLAY_NAME=Barlas Owner
OWNER_LANGUAGE=
SESSION_TTL_HOURS=168
AGENT_MAX_STEPS=8
AGENT_MAX_TOTAL_TOKENS=50000
AGENT_MAX_OUTPUT_TOKENS_PER_STEP=4096
AGENT_RUN_WORKER_ENABLED=true
AGENT_RUN_WORKER_POLL_MS=1000
AGENT_RUN_WORKER_BATCH_SIZE=2
AGENT_RUN_LEASE_SECONDS=300
WEB_ROOT=/app/web
