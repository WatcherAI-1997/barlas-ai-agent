# Barlas AI Agent — non-secret configuration template
APP_ENV=development
APP_NAME=Barlas AI Agent
HOST=127.0.0.1
PORT=17840
LOG_LEVEL=info

# Set real values only in a local .env or secret manager.
DATABASE_URL=postgresql://barlas_agent:change-me@127.0.0.1:5432/barlas_agent
POSTGRES_PASSWORD=change-me
BARLAS_API_TOKEN=replace-with-at-least-32-random-characters
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
DEEP_MODEL_NAME=
DEEP_MODEL_INPUT_USD_PER_MILLION=
DEEP_MODEL_OUTPUT_USD_PER_MILLION=
MODEL_API_KEY=
PRIVATE_MODEL_BASE_URL=
PRIVATE_MODEL_NAME=
PRIVATE_MODEL_API_KEY=
PRIVATE_MODEL_INPUT_USD_PER_MILLION=0
PRIVATE_MODEL_OUTPUT_USD_PER_MILLION=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Durable background worker (runs inside the isolated Barlas service).
JOB_WORKER_ENABLED=true
JOB_WORKER_POLL_MS=1000
JOB_WORKER_BATCH_SIZE=4
JOB_LEASE_SECONDS=300

# Dedicated storage used only by Barlas AI Agent. Each user gets a hashed subdirectory.
WORKSPACE_ROOT=/var/lib/barlas/workspaces

# Optional self-hosted SearXNG endpoint. web.search is disabled when omitted.
SEARXNG_BASE_URL=

# Per-user UTC-day limits.
DAILY_CHAT_QUOTA=500
DAILY_TOOL_QUOTA=1000
DAILY_JOB_QUOTA=100

# Optional first owner bootstrap. Use a unique password of at least 12 characters.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=Barlas Owner
SESSION_TTL_HOURS=168
AGENT_MAX_STEPS=8
AGENT_MAX_TOTAL_TOKENS=50000
AGENT_MAX_OUTPUT_TOKENS_PER_STEP=4096
WEB_ROOT=/app/web
