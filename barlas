#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$ROOT_DIR/deploy/local.env" ]]; then
  ENV_FILE="$ROOT_DIR/deploy/local.env"
  compose=(docker compose -f "$ROOT_DIR/compose.production.yml" -f "$ROOT_DIR/compose.local.yml" --env-file "$ENV_FILE")
elif [[ -f "$ROOT_DIR/deploy/production.env" ]]; then
  ENV_FILE="$ROOT_DIR/deploy/production.env"
  compose=(docker compose -f "$ROOT_DIR/compose.production.yml" --env-file "$ENV_FILE")
else
  printf 'Barlas is not configured. Run ./install.sh --local first.\n' >&2
  exit 1
fi

export BARLAS_ENV_FILE="$ENV_FILE"
exec_flags=()
if [[ ! -t 0 || ! -t 1 ]]; then exec_flags=(-T); fi
exec "${compose[@]}" exec "${exec_flags[@]}" api node dist/src/cli.js "$@"
