{
  "name": "barlas-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Barlas AI Agent core runtime",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run --exclude 'dist/**' tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:security": "node scripts/security-check.mjs",
    "test:load": "node scripts/load-smoke.mjs",
    "eval:agent": "npm run build && node scripts/run-agent-evals.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "croner": "^10.0.1",
    "docx": "^9.5.1",
    "fastify": "^5.6.1",
    "jszip": "^3.10.1",
    "openai": "^6.7.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "playwright-core": "^1.64.1",
    "undici": "^7.30.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
