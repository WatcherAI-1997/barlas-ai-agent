{
  "name": "barlas-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Barlas AI Agent core runtime",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:isolation": "node scripts/check-isolation.mjs"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "fastify": "^5.6.1",
    "openai": "^6.7.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

